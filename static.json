{
    "redirects": [
        {
            "source": "/downloads/tenant-switcher.msi",
            "destination": "/downloads/Tenant%20Switcher.msi",
            "type": 301
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "destination": "/index.html"
        }
